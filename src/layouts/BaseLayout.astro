---
import AuthNav from '../components/AuthNav.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'y/cs Catalyst' } = Astro.props;
const pageTitle = title === 'Catalyst' ? 'Catalyst · y/cs' : `${title} · Catalyst`;

const nav = [
  { href: '/members', label: 'Members' },
  { href: '/leaderboard', label: 'Leaderboard' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header container">
      <a href="/" class="brand">
        <img src="/ycs-logo.png" alt="y/cs" width="52" height="24" />
        <span class="label">Catalyst</span>
      </a>
      <nav aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        <AuthNav server:defer />
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer container">
      <img src="/ycs-logo.png" alt="y/cs" width="36" height="16" />
      <span class="label footer-label">Catalyst · Fall 2026</span>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: var(--line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    text-decoration: none;
  }
  .brand img {
    width: 52px;
    height: auto;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 150ms ease-out;
  }
  nav a:hover {
    color: var(--color-text);
  }
  nav a[aria-current='page'] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
  }

  @media (max-width: 720px) {
    .brand img {
      width: 44px;
    }
    nav {
      gap: var(--space-4);
    }
  }

  .footer-label {
    color: var(--color-text-muted);
  }
</style>
