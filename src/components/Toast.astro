---
// A short confirmation that disappears after 4 seconds (DESIGN.md §7, Toasts).
interface Props {
  message: string | null;
}
const { message } = Astro.props;
---

{message && <div class="toast" role="status" data-toast>{message}</div>}

<script>
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  if (toast) {
    setTimeout(() => toast.remove(), 4000);
    // Drop ?added=… so a refresh doesn't show the toast again.
    const url = new URL(location.href);
    url.searchParams.delete('added');
    url.searchParams.delete('amount');
    history.replaceState(null, '', url);
  }
</script>

<style>
  .toast {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    max-width: calc(100% - 2 * var(--space-4));
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-slash);
    border-radius: var(--radius);
    color: var(--color-text);
    font-size: var(--text-small);
    font-weight: 500;
  }
  @media (max-width: 720px) {
    .toast {
      right: auto;
      left: 50%;
      transform: translateX(-50%);
      bottom: var(--space-4);
    }
  }
</style>
