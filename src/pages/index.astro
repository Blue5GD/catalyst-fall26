---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const sprints = [
  { title: 'Personal website', dates: 'Sep 28 – Oct 11' },
  { title: 'AI agent', dates: 'Oct 12 – Oct 25' },
  { title: 'Board-game bot tournament', dates: 'Nov 2 – Nov 15' },
  { title: 'Final project: free build', dates: 'Nov 16 – Dec 6' },
  { title: 'Demo Day', dates: 'Dec 7 – 13' },
];

// Updates from happening-now/*.md, newest first.
const updates = await Promise.all(
  (await getCollection('now'))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Catalyst">
  <section class="hero page">
    <div class="slash" aria-hidden="true"></div>
    <div>
      <h1>Catalyst</h1>
      <p class="label hero-label">Fall 2026 · y/cs</p>
      <p class="hero-intro">The Catalyst homepage. Check here for project, personal, and leaderboard updates.</p>
      <p class="hero-links">
        <a href="/members">See the members</a>
        <a href="/leaderboard">Check the leaderboard</a>
      </p>
    </div>
  </section>

  <section class="agenda" aria-labelledby="agenda-title">
    <h3 id="agenda-title">Sprints</h3>
    <ol>
      {
        sprints.map((sprint, i) => (
          <li>
            <span class="agenda-num num">{String(i + 1).padStart(2, '0')}</span>
            <span class="agenda-title">{sprint.title}</span>
            <span class="agenda-dates num">{sprint.dates}</span>
          </li>
        ))
      }
    </ol>
  </section>

  {
    updates.length > 0 && (
      <section class="now" aria-labelledby="now-title">
        <h3 id="now-title">Happening now</h3>
        {updates.map(({ data, Content }) => (
          <article class="now-item">
            <div class="now-head">
              <h4>{data.title}</h4>
              <time class="now-date num" datetime={data.date.toISOString().slice(0, 10)}>
                {formatDate(data.date)}
              </time>
            </div>
            <div class="prose">
              <Content />
            </div>
          </article>
        ))}
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .hero-label {
    margin-top: var(--space-4);
  }
  .hero-intro {
    margin-top: var(--space-5);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-5);
    font-weight: 500;
  }
  .hero-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .agenda {
    margin-top: var(--space-8);
  }
  .agenda ol {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }
  .agenda li {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: var(--line);
  }
  .agenda-num {
    color: var(--color-text-muted);
  }
  .agenda-title {
    color: var(--color-text);
    font-weight: 500;
  }
  .agenda-dates {
    color: var(--color-text-muted);
    font-size: var(--text-small);
  }

  .now {
    margin-top: var(--space-8);
  }
  .now-item {
    padding-block: var(--space-5);
    border-bottom: var(--line);
  }
  .now-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }
  .now-date {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }

  /* Markdown from happening-now/. */
  .prose {
    margin-top: var(--space-3);
    max-width: 65ch;
  }
  .prose :global(> * + *) {
    margin-top: var(--space-3);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 0;
    padding-left: var(--space-5);
  }
  .prose :global(li + li) {
    margin-top: var(--space-1);
  }
  .prose :global(li:has(> input[type='checkbox'])) {
    list-style: none;
    margin-left: calc(-1 * var(--space-5));
  }
  .prose :global(input[type='checkbox']) {
    accent-color: var(--color-accent);
    margin: 0 var(--space-2) 0 0;
    vertical-align: -2px;
  }
  .prose :global(strong) {
    color: var(--color-text);
  }

  @media (max-width: 720px) {
    .now {
      margin-top: var(--space-7);
    }
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
    }
    .agenda {
      margin-top: var(--space-7);
    }
    .agenda li {
      grid-template-columns: 44px 1fr;
    }
    .agenda-dates {
      grid-column: 2;
    }
  }
</style>
